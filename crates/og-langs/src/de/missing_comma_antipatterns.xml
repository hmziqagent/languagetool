    <pattern>
      <token postag="VER:.*1:SIN:KJ1:.+" postag_regexp="yes"/>
      <token postag="VER:MOD:[12]:.+" postag_regexp="yes"/>
      <token postag="PKT|KON:NEB" postag_regexp="yes"/>
