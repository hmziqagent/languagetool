  </rule>
  <rule id="MCCAP_25">
    <pattern>
      <token postag="VER.*" postag_regexp="yes"/>
      <token regexp="yes">&#x2063;</token>
    </pattern>
    <message>internal antipattern</message>
  </rule>
</rules>
